# mongo (default), sqlite or postgres
DATABASE_ADAPTER=mongo
# The dev app's database. `pnpm test:int` never uses it, because it drops the database it runs
# against: it starts its own (test/helpers/testDatabase.ts; PAYLOAD_TEST_DATABASE_URL picks a
# local Postgres).
DATABASE_URL=mongodb://127.0.0.1/payload-passkeys
PAYLOAD_SECRET=YOUR_SECRET_HERE
