# mongo (default), sqlite or postgres
DATABASE_ADAPTER=mongo
# The dev app's database. `pnpm test:int` never reads it, because it drops the database it runs
# against: MongoDB and SQLite get a throwaway one, and Postgres uses payload_passkeys_test on the
# same local server, created on first run (test/helpers/testDatabase.ts). Set
# PAYLOAD_TEST_DATABASE_URL to pick another local Postgres database for the suite.
DATABASE_URL=mongodb://127.0.0.1/payload-passkeys
PAYLOAD_SECRET=YOUR_SECRET_HERE
