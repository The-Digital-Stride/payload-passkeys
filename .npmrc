engine-strict=true
save-exact=true
# From payload-starter: Turbopack (Next 16.1+) copies serverExternalPackages into
# .next/dev/node_modules/<pkg>-<hash>/, severing pnpm symlinks so their deps stop resolving
# (vercel/next.js#87737). The dev app needs a flat node_modules. Task 37 checks the published
# package resolves without it.
shamefully-hoist=true
